{
  description = "Cross-compilation sysroot and toolchain for the OLPC XO-1 (OLPC OS 13.2.10, Fedora 18)";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";

  outputs = { self, nixpkgs }:
    let
      system = "x86_64-linux";
      pkgs = nixpkgs.legacyPackages.${system};
      lib = pkgs.lib;

      # Generated by tools/gen-sysroot-lock.py from the XO's `rpm -qa`.
      lock = builtins.fromJSON (builtins.readFile ./sysroot/lock.json);

      target = "i686-redhat-linux";

      # Fedora 18 + OLPC RPMs unpacked into one tree: runtime libraries exactly as
      # installed on the XO, plus the matching -devel packages and gcc's crt/libgcc.
      sysroot = pkgs.stdenvNoCC.mkDerivation {
        pname = "xo1-sysroot";
        version = "13.2.10";
        srcs = map (p: pkgs.fetchurl {
          inherit (p) url sha256;
          name = baseNameOf p.url;
        }) lock;
        nativeBuildInputs = [ pkgs.libarchive ];
        dontUnpack = true;
        dontConfigure = true;
        dontBuild = true;
        # Contents are i686 Fedora binaries: no patchelf, strip or shebang rewriting.
        dontFixup = true;
        installPhase = ''
          runHook preInstall
          mkdir -p $out
          for f in $srcs; do
            bsdtar -xf "$f" -C $out --no-same-owner --no-same-permissions
          done
          chmod -R u+w $out

          # Fedora 18 has merged /usr: /lib, /bin and /sbin are symlinks into /usr.
          for d in lib bin sbin; do
            if [ -d $out/$d ] && [ ! -L $out/$d ]; then
              mkdir -p $out/usr/$d
              cp -a $out/$d/. $out/usr/$d/
              rm -rf $out/$d
            fi
            ln -sfn usr/$d $out/$d
          done

          # Absolute symlinks would point into the build host; make them relative.
          find $out -type l | while read -r l; do
            t=$(readlink "$l")
            case "$t" in
              /*) ln -sfn "$(realpath -m --relative-to="$(dirname "$l")" "$out$t")" "$l" ;;
            esac
          done

          rm -rf $out/usr/share/{doc,man,info,locale,gtk-doc,help,licenses}
          runHook postInstall
        '';
      };

      clang = pkgs.llvmPackages.clang-unwrapped;
      llvm = pkgs.llvmPackages.llvm;
      lld = pkgs.llvmPackages.lld;

      # -march=geode: no SSE, no long NOPs (the Geode LX lacks NOPL).
      # libgcc and libstdc++ come from the sysroot (gcc 4.7.2), so binaries only
      # depend on libraries that exist on the XO.
      ccFlags = lib.concatStringsSep " " [
        "--target=${target}"
        "--sysroot=${sysroot}"
        "-march=geode"
        "-mtune=geode"
      ];
      linkFlags = lib.concatStringsSep " " [
        "--ld-path=${lld}/bin/ld.lld"
        "--rtlib=libgcc"
        "--unwindlib=libgcc"
        "-Wl,-dynamic-linker,/lib/ld-linux.so.2"
      ];

      # libstdc++ 4.7 predates C++14 sized and C++17 aligned operator delete/new,
      # which current clang emits by default.
      cxxFlags = "-fno-sized-deallocation -fno-aligned-allocation";

      wrap = name: text: pkgs.writeShellScriptBin name text;

      # Link flags are only passed when linking, to keep -c quiet. nixpkgs' unwrapped
      # clang does not pass a default -dynamic-linker (its cc-wrapper normally does).
      ccWrapper = name: compiler: extra: wrap name ''
        link=1
        for a in "$@"; do
          case "$a" in -c|-S|-E|-M|-MM) link=0 ;; esac
        done
        if [ $link = 1 ]; then
          set -- ${linkFlags} "$@"
        fi
        exec ${clang}/bin/${compiler} ${ccFlags} ${extra} "$@"
      '';

      toolchain = pkgs.symlinkJoin {
        name = "xo1-toolchain";
        paths = [
          (ccWrapper "xo-cc" "clang" "")
          (ccWrapper "xo-c++" "clang++" cxxFlags)
          (wrap "xo-pkg-config" ''
            export PKG_CONFIG_SYSROOT_DIR=${sysroot}
            export PKG_CONFIG_LIBDIR=${sysroot}/usr/lib/pkgconfig:${sysroot}/usr/share/pkgconfig
            unset PKG_CONFIG_PATH
            exec ${pkgs.pkg-config-unwrapped}/bin/pkg-config "$@"
          '')
        ];
        # Triple-prefixed names so autotools' --host=${target} finds the tools.
        postBuild = ''
          cd $out/bin
          for t in gcc cc clang; do ln -s xo-cc ${target}-$t; done
          for t in g++ c++ clang++; do ln -s xo-c++ ${target}-$t; done
          ln -s xo-pkg-config ${target}-pkg-config
          for t in ar nm ranlib strip objcopy objdump readelf size strings; do
            ln -s ${llvm}/bin/llvm-$t xo-$t
            ln -s ${llvm}/bin/llvm-$t ${target}-$t
          done
          ln -s ${lld}/bin/ld.lld ${target}-ld
        '';
      };

      cmakeToolchain = pkgs.writeText "xo1-toolchain.cmake" ''
        set(CMAKE_SYSTEM_NAME Linux)
        set(CMAKE_SYSTEM_PROCESSOR i686)
        set(CMAKE_SYSROOT ${sysroot})
        set(CMAKE_C_COMPILER ${toolchain}/bin/xo-cc)
        set(CMAKE_CXX_COMPILER ${toolchain}/bin/xo-c++)
        set(CMAKE_AR ${toolchain}/bin/xo-ar)
        set(CMAKE_RANLIB ${toolchain}/bin/xo-ranlib)
        set(CMAKE_STRIP ${toolchain}/bin/xo-strip)
        set(PKG_CONFIG_EXECUTABLE ${toolchain}/bin/xo-pkg-config)
        set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
        set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
        set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
        set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
      '';

      mesonCross = pkgs.writeText "xo1-cross.ini" ''
        [binaries]
        c = '${toolchain}/bin/xo-cc'
        cpp = '${toolchain}/bin/xo-c++'
        ar = '${toolchain}/bin/xo-ar'
        strip = '${toolchain}/bin/xo-strip'
        pkg-config = '${toolchain}/bin/xo-pkg-config'

        [properties]
        sys_root = '${sysroot}'

        [host_machine]
        system = 'linux'
        cpu_family = 'x86'
        cpu = 'i586'
        endian = 'little'
      '';
      demos = pkgs.runCommand "xo1-demos" { nativeBuildInputs = [ toolchain ]; } ''
        mkdir -p $out/bin
        cd ${./demos}
        xo-cc -O2 -Wall -Wextra -o $out/bin/x11-accel x11-accel.c \
          $(xo-pkg-config --cflags --libs x11 xext xv xrender) -lm
        xo-cc -O2 -Wall -Wextra -o $out/bin/sdl-accel sdl-accel.c \
          $(xo-pkg-config --cflags --libs sdl) -lm
        xo-cc -O2 -Wall -Wextra -o $out/bin/tilemap tilemap.c \
          $(xo-pkg-config --cflags --libs x11 xext xv xrender) -lm
      '';
    in
    {
      packages.${system} = {
        inherit sysroot toolchain;
        cmake-toolchain = cmakeToolchain;
        meson-cross = mesonCross;
        inherit demos;
        default = toolchain;
      };

      devShells.${system}.default = pkgs.mkShellNoCC {
        packages = [ toolchain pkgs.cmake pkgs.meson pkgs.ninja pkgs.gnumake ];
        XO_SYSROOT = sysroot;
        XO_CMAKE_TOOLCHAIN = cmakeToolchain;
        XO_MESON_CROSS = mesonCross;
        CC = "xo-cc";
        CXX = "xo-c++";
        AR = "xo-ar";
        RANLIB = "xo-ranlib";
        STRIP = "xo-strip";
        PKG_CONFIG = "xo-pkg-config";
      };

      # Compile and link the test programs; running them needs the XO itself.
      checks.${system} = {
        inherit demos;
        hello = pkgs.runCommand "xo1-hello" { nativeBuildInputs = [ toolchain ]; } ''
          mkdir -p $out
          xo-cc -O2 -Wall -o $out/hello-c ${./tests/hello.c} -lm
          xo-c++ -O2 -Wall -o $out/hello-cxx ${./tests/hello.cpp}
          xo-cc -O2 -Wall -o $out/sdl-test ${./tests/sdl-test.c} $(xo-pkg-config --cflags --libs sdl)
          xo-cc -O2 -Wall -o $out/gtk3-test ${./tests/gtk3-test.c} $(xo-pkg-config --cflags --libs gtk+-3.0)
        '';
      };
    };
}
